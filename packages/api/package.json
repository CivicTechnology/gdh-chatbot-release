{
  "name": "@gdh-chatbot/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 3001 --silent",
    "dev": "tsx watch --env-file=../../.env.local src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:generate": "bunx prisma generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:deploy": "bunx prisma migrate deploy",
    "db:push": "bunx prisma db push",
    "db:pull": "bunx prisma db pull",
    "db:studio": "bunx prisma studio"
  },
  "exports": {
    "./app": {
      "types": "./src/app.ts",
      "import": "./dist/app.js"
    },
    "./prisma": {
      "types": "./src/generated/prisma/index.d.ts",
      "import": "./src/generated/prisma/index.js"
    },
    "./db": {
      "types": "./src/lib/db/prisma.ts",
      "import": "./dist/lib/db/prisma.js",
      "require": "./dist/lib/db/prisma.js"
    }
  },
  "dependencies": {
    "@ai-sdk/azure": "2.0.123",
    "@ai-sdk/openai": "^2.0.15",
    "@ai-sdk/xai": "^2.0.13",
    "@azure/storage-blob": "^12.31.0",
    "@gdh-chatbot/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/client-runtime-utils": "^7.2.0",
    "ai": "5.0.108",
    "alasql": "^4.17.0",
    "bcrypt-ts": "^5.0.2",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "file-type": "^21.1.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.17.1",
    "redis": "^5.0.0",
    "resumable-stream": "^2.0.0",
    "tailwind-merge": "^2.5.5",
    "tokenlens": "^1.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/pg": "^8.16.0",
    "prisma": "^7.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
