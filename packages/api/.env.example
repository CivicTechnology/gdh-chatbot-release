# Server Configuration
NODE_ENV=development
PORT=3001

# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/gdh_chatbot

# Redis (optional - for resumable streams)
REDIS_URL=redis://localhost:6379

# Authentication
# SECURITY: AUTH_SECRET must be at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-character-secret-key-here

# Frontend
FRONTEND_URL=http://localhost:5173

# File uploads (Azure Blob Storage)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=uploads
# Optional: use a connection string instead of account + key
AZURE_STORAGE_CONNECTION_STRING=

# AI Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
