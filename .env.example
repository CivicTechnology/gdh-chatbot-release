# Auth secret — minimum 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET=

# Database: local dev via Docker
#   POSTGRES_URL=postgres://postgres:postgres@localhost:5432/chatbot
# Azure Database for PostgreSQL (production):
#   POSTGRES_URL=postgresql://user:password@<server>.postgres.database.azure.com:5432/chatbot?sslmode=require
POSTGRES_URL=

# Redis (optional, for resumable chat streams)
# Local: redis://localhost:6379
REDIS_URL=

# AI providers — "azure" (default) or "openai"
AI_PROVIDER=azure
# Azure OpenAI
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
# OpenAI (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=

# File uploads (Azure Blob Storage)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=uploads
# Alternatively: AZURE_STORAGE_CONNECTION_STRING=
# Leave key and connection string empty to use managed identity
# (DefaultAzureCredential + the Storage Blob Data Contributor role).

# ArcGIS
ARC_GIS_BASE_URL=https://ddh.maps.arcgis.com
ARC_GIS_STADSLANDBOUW_EMBED_URL=https://ddh.maps.arcgis.com/apps/instant/nearby/index.html?appid=3f6e63b5c3f54e2bbf0b14578d88556b
ARC_GIS_STADSLANDBOUW_APP_ID=3f6e63b5c3f54e2bbf0b14578d88556b
ARC_GIS_SOURCE_NAME=Geoportaal Den Haag

# --- Entra ID SSO (beheerportaal) — leeg laten = SSO uit, lokale login als fallback ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_REDIRECT_URI=            # <origin>/api/auth/entra/callback (same-origin met de SPA)
ENTRA_POST_LOGOUT_REDIRECT_URI=
ENTRA_BEHEERDER_ROLE=beheerder
ENTRA_SESSION_MAX_AGE=28800    # admin-sessie-TTL in seconden (default 8u)
# Credential — kies secret OF certificaat (certificaat/federated heeft de voorkeur in productie)
ENTRA_CLIENT_SECRET=
ENTRA_CLIENT_CERT_PATH=
ENTRA_CLIENT_CERT_THUMBPRINT=

# --- Lokale break-glass beheerder-login (default uit; vereist MFA als aan) ---
LOCAL_LOGIN_ENABLED=false
