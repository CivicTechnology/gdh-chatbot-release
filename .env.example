# Auth secret — minimum 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET=

# Database: local dev via Docker
#   POSTGRES_URL=postgres://postgres:postgres@localhost:5432/chatbot
# Azure Database for PostgreSQL (production):
#   POSTGRES_URL=postgresql://user:password@<server>.postgres.database.azure.com:5432/chatbot?sslmode=require
POSTGRES_URL=

# Redis (optional, for resumable chat streams)
# Local: redis://localhost:6379
REDIS_URL=

# AI providers
OPENAI_API_KEY=
# Optional: used only when OIDC/AI Gateway is not available
AI_GATEWAY_API_KEY=

# File uploads (Azure Blob Storage)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=uploads
# Alternatively: AZURE_STORAGE_CONNECTION_STRING=