{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/next"],
  "files": {
    "includes": [
      "**/*",
      "!packages/web/components/ui",
      "!packages/web/lib/utils.ts",
      "!packages/web/hooks/use-mobile.ts",
      "!pipeline/storage",
      "!pipeline/data-collection",
      "!pipeline/data",
      "!pipeline/debug",
      "!packages/python",
      "!.pnpm-store"
    ]
  },
  "formatter": {
    "lineEnding": "lf"
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off",
        "noConsole": "off",
        "noBitwiseOperators": "off"
      }
    }
  }
}
